# ──────────────────────────────────────────────────────────────────────────
# AstraOS Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env — it is excluded by .gitignore.
# ──────────────────────────────────────────────────────────────────────────

# ── Authentication ────────────────────────────────────────────────────────
# Optional bearer token for all protected API endpoints.
# Leave empty to disable token auth (development only).
ASTRAOS_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────
# SQLite database path for telemetry history.
ASTRAOS_DB_PATH=data/astraos.db

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ASTRAOS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Edge Node Discovery ───────────────────────────────────────────────────
# Register real edge nodes for distributed telemetry and heartbeat.
# Format: name=host:port,name2=host2:port2
# Example: astra-edge-01=127.0.0.1:8080,astra-edge-02=192.168.1.10:8080
ASTRAOS_EDGE_NODES=

# ── Telemetry Sampling ────────────────────────────────────────────────────
# How often (in seconds) the background loop samples host telemetry.
ASTRAOS_SAMPLE_INTERVAL=1

# ── Rate Limiting ─────────────────────────────────────────────────────────
# Maximum API requests per minute per client IP.
ASTRAOS_RATE_LIMIT_PER_MINUTE=600

# ── Edge Node Identity (when running as an edge agent) ────────────────────
ASTRAOS_NODE_NAME=astra-edge-01
ASTRAOS_NODE_ROLE=edge-worker
ASTRAOS_NODE_WORKLOAD=container telemetry
ASTRAOS_EDGE_NODE_ID=node-01

# ── Dashboard (Vite) ──────────────────────────────────────────────────────
VITE_ASTRAOS_API_URL=http://127.0.0.1:8000
VITE_ASTRAOS_TOKEN=

# ── Website (Next.js) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000
NEXT_PUBLIC_ASTRAOS_DASHBOARD_URL=http://127.0.0.1:5173
NEXT_PUBLIC_GITHUB_URL=https://github.com/IamChandu114/AstraOS
